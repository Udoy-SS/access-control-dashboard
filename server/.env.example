# Suprema BioStar 2 / BioStar X Enterprise Connection Configuration
# Pubali Bank Central Biometric Access Control & Attendance Platform

# Server Port
PORT=5050

# BioStar 2 / BioStar X Server Host or IP (On-Premises Server / Cloud Gateway)
BIOSTAR_HOST=biostar-central.pubalibank.com
BIOSTAR_PORT=443
BIOSTAR_SSL=true

# BioStar API Administrator Credentials
BIOSTAR_USERNAME=admin
BIOSTAR_PASSWORD=

# Synchronization Settings
BIOSTAR_ENABLED=false
BIOSTAR_AUTO_SYNC=true
BIOSTAR_SYNC_INTERVAL_SEC=60
